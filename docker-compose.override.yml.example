# Локальная разработка на своей машине (не VDS1).
#
# docker-compose.yml намеренно биндит postgres/api на конкретный
# Tailscale-IP VDS1 (<TAILSCALE_IP>) — так их видят другие VDS (Pinance_ML
# читает БД напрямую, promote_if_better.py ходит в /admin/metrics/...).
# На локальной машине такого интерфейса физически нет — docker откажется
# биндиться ("can't bind on the specified endpoint").
#
# Скопируйте этот файл в docker-compose.override.yml (без .example) — он
# уже в .gitignore, «свой» для каждого разработчика и НЕ должен попасть в
# git: docker compose подхватывает docker-compose.override.yml
# автоматически при каждом `docker compose up`, и если он закоммичен — то
# же самое произойдёт и на проде при следующем git pull, молча перебив
# Tailscale-биндинг на localhost.
#
# !override — не слияние списка (по умолчанию compose КОНКАТЕНИРУЕТ ports,
# не заменяет — проверено на v2.40.3), а замена целиком, иначе останется
# и старая, невалидная здесь запись на <TAILSCALE_IP> тоже.
#
# Хост-порт postgres — 5433, не 5432: у многих локально уже стоит свой
# Postgres (нативный, не в Docker) на 5432, второй бинд на тот же порт
# упадёт с ошибкой доступа к сокету. api внутри docker-сети всё равно
# ходит на postgres:5432 (внутренний DNS-хост контейнера), хост-порт нужен
# только для подключения снаружи (pgAdmin/DBeaver и т.п.) — если у вас
# 5432 свободен, можно вернуть как есть, разницы для приложения нет.
services:
  postgres:
    ports: !override
      - "127.0.0.1:5433:5432"

  api:
    ports: !override
      - "127.0.0.1:8002:8000"
