# ─── Postgres ──────────────────────────────────────────────
POSTGRES_DB=pinance
POSTGRES_USER=pinance
# Required by docker-compose. Replace before exposing anything.
POSTGRES_PASSWORD=changeme

# ─── App ───────────────────────────────────────────────────
APP_ENV=dev              # dev (console logs) | prod (JSON logs)
LOG_LEVEL=INFO

# ─── Inference service (Pinance_ml_inference) ──────────────
# Inside the api container "localhost" is the container itself, so point this
# at an address the container can reach.
ML_INFERENCE_URL=http://localhost:8001
ML_INFERENCE_TIMEOUT_S=5.0
ML_POLL_INTERVAL_MINUTES=5

# Number of candles sent in the body of POST /predict/{symbol}. Keep it in sync
# with MIN_WARMUP_CANDLES in Pinance_ml_inference (see app/config.py).
ML_CANDLE_WINDOW_SIZE=150

# Upper bound of the gap scan (sync_predictions in app/scheduler/jobs.py):
# candles without a forecast that are older than this are not looked for
# (see app/config.py for why).
ML_GAP_LOOKBACK_HOURS=48

# Refresh of the cached /metrics/*, /candles/*/pred_history, etc. This is
# deliberately a separate job and interval from ML_POLL_INTERVAL_MINUTES (see the
# module docstring of app/scheduler/jobs.py): the expensive aggregation must not
# be able to block or skip the intake of forecasts.
METRICS_REFRESH_INTERVAL_MINUTES=5

# Shadow deployment: also poll the candidate model. Enable only while a
# candidate is actually being compared with production (the inference service
# must serve /predict/{symbol}/shadow).
ML_SHADOW_ENABLED=false

# These two are set by docker-compose from POSTGRES_* and the service names.
# Listed here for transparency only; do not edit.
# DATABASE_URL=postgresql+asyncpg://pinance:...@postgres:5432/pinance
# REDIS_URL=redis://redis:6379/0
